# Copy to .env and fill in. All settings are optional except the API key.

FV_ANTHROPIC_API_KEY=

# Defaults match infra/docker-compose.yml; override only if you moved the ports.
FV_PG_DSN=postgresql://financevault:financevault@localhost:55432/financevault
FV_REDIS_URL=redis://localhost:55433/0

# Execution budget. The ledger aborts a run that breaches either.
FV_MAX_STEPS=6
FV_MAX_USD=0.05

# When true, every model call must resolve from the journal; a miss raises rather than
# falling back to a live call, so a replay can never silently cost money.
FV_REPLAY=false

# SEC requires a descriptive User-Agent with real contact details on every request.
FV_SEC_USER_AGENT=FinanceVault research (sb9880@nyu.edu)
